root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yaml,yml,toml,pkl}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = tab
tab_width = 8

[*.sh]
indent_style = space
indent_size = 2
switch_case_indent = true

[.mise/tasks/**]
indent_style = space
indent_size = 2
switch_case_indent = true

[*.{md,markdown}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
